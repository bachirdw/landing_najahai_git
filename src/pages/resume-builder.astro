---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import FooterSimple from "../components/FooterSimple.astro";
import { APP_URL } from "../lib/site";

const templates = ["Classic", "Accent", "Minimal", "Two-Column"];
---
<BaseLayout
  title="Resume Builder — Najah AI"
  description="Najah rewrites your resume automatically for each job description — ATS-ready, keyword-matched, ready in seconds."
  path="/resume-builder"
>
  <Nav active="resume-builder" />

  <section style="position:relative;overflow:hidden">
    <div style="position:absolute;inset:0;background:radial-gradient(55% 55% at 20% 10%, rgba(255,196,120,.3), transparent 60%), radial-gradient(50% 50% at 80% 30%, rgba(120,190,255,.26), transparent 60%);z-index:0"></div>
    <div class="wrap" style="position:relative;z-index:1;padding:72px 24px 56px;display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center">
      <div>
        <div style="font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#555;margin-bottom:14px">Resume Builder</div>
        <h1 style="font-weight:800;font-size:clamp(32px,4.4vw,46px);line-height:1.12;letter-spacing:-0.02em;margin:0 0 16px">An ATS-ready resume for every job you apply to</h1>
        <p style="font-size:15.5px;line-height:1.65;color:#555;margin:0 0 24px">Najah rewrites your resume automatically for each job description — same experience, keywords and structure matched to what the role is actually asking for. Every version is built to pass an applicant tracking system.</p>
        <a href={APP_URL} class="btn-primary">Try it free</a>
      </div>
      <div class="win">
        <div class="win-bar"><div class="win-dot"></div><div class="win-dot"></div><div class="win-dot"></div></div>
        <div style="padding:18px;display:flex;gap:14px">
          <div style="flex:1;border:1px solid var(--color-border);border-radius:10px;padding:14px">
            <div style="font-weight:700;font-size:13px;margin-bottom:10px">ATS Readiness</div>
            <div style="font-size:28px;font-weight:800;color:var(--color-success);margin-bottom:4px">92</div>
            <div style="font-size:12px;color:#888">Keyword match: strong</div>
          </div>
          <div style="flex:1;border:1px solid var(--color-border);border-radius:10px;padding:14px;display:flex;flex-direction:column;gap:8px">
            <div style="font-weight:700;font-size:13px;margin-bottom:2px">Professional Experience</div>
            <div class="bar bar-fill"></div>
            <div class="bar" style="width:80%"></div>
            <div class="bar bar-fill" style="width:65%"></div>
            <div class="bar" style="width:75%"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div style="height:1px;background:var(--color-border)"></div>

  <section class="wrap" style="padding:56px 24px">
    <h2 style="font-weight:800;font-size:24px;margin:0 0 8px;letter-spacing:-0.01em">Clean templates, built for readability</h2>
    <p style="font-size:14.5px;color:#666;margin:0 0 32px;max-width:60ch">Choose a layout, and Najah tailors it automatically for every application. Export to PDF or DOCX anytime.</p>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:20px">
      {templates.map((name) => (
        <div style="border:1px solid var(--color-border);border-radius:14px;padding:16px">
          <div style="height:180px;border:1px solid var(--color-border);border-radius:10px;margin-bottom:12px;display:flex;flex-direction:column;gap:6px;padding:14px">
            <div style="height:6px;width:60%;background:#111;border-radius:3px"></div>
            <div style="height:5px;width:40%;background:#ddd;margin-bottom:8px;border-radius:3px"></div>
            <div style="height:5px;background:#f0f0f0;border-radius:3px"></div>
            <div style="height:5px;background:#f0f0f0;width:80%;border-radius:3px"></div>
            <div style="height:5px;background:#f0f0f0;width:90%;border-radius:3px"></div>
          </div>
          <div style="font-weight:700;font-size:14px">{name}</div>
        </div>
      ))}
    </div>
  </section>

  <div style="height:1px;background:var(--color-border)"></div>

  <section class="wrap" style="padding:56px 24px;text-align:center">
    <h2 style="font-weight:800;font-size:26px;margin:0 0 14px;letter-spacing:-0.01em">Build your resume once. Najah tailors it forever.</h2>
    <a href={APP_URL} class="btn-primary">Build my resume free</a>
  </section>

  <FooterSimple />
</BaseLayout>
