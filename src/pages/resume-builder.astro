---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import FooterSimple from "../components/FooterSimple.astro";
import { APP_URL } from "../lib/site";

const templates = ["Classic", "Accent", "Minimal", "Two-Column"];
---
<BaseLayout
  title="Resume Builder — Najah AI"
  description="Najah rewrites your resume automatically for each job description — ATS-ready, keyword-matched, ready in seconds."
  path="/resume-builder"
>
  <Nav active="resume-builder" />

  <section class="page-hero">
    <div class="page-hero-glow page-hero-glow--builder"></div>
    <div class="wrap page-hero-inner page-hero-split">
      <div>
        <div class="page-hero-kicker">Resume Builder</div>
        <h1 class="page-hero-title page-hero-title--left">An ATS-ready resume for every job you apply to</h1>
        <p class="page-hero-body page-hero-body--left">Najah rewrites your resume automatically for each job description — same experience, keywords and structure matched to what the role is actually asking for. Every version is built to pass an applicant tracking system.</p>
        <a href={APP_URL} class="btn-primary page-hero-cta">Try it free</a>
      </div>
      <div class="win page-hero-visual">
        <div class="win-bar"><div class="win-dot"></div><div class="win-dot"></div><div class="win-dot"></div></div>
        <div class="mock mock-cols">
          <div class="mock-col mock-col--ats">
            <div class="mock-col-title">ATS Readiness</div>
            <div class="ats-score">92</div>
            <div class="ats-note">Keyword match: strong</div>
          </div>
          <div class="mock-col">
            <div class="mock-col-title">Professional Experience</div>
            <div class="bar bar-fill"></div>
            <div class="bar" style="width:80%"></div>
            <div class="bar bar-fill" style="width:65%"></div>
            <div class="bar" style="width:75%"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div style="height:1px;background:var(--color-border)"></div>

  <section class="wrap templates-section">
    <h2 class="templates-title">Clean templates, built for readability</h2>
    <p class="templates-body">Choose a layout, and Najah tailors it automatically for every application. Export to PDF or DOCX anytime.</p>
    <div class="templates-grid">
      {templates.map((name) => (
        <div class="template-card">
          <div class="template-preview">
            <div class="template-line template-line--name"></div>
            <div class="template-line template-line--role"></div>
            <div class="template-line"></div>
            <div class="template-line" style="width:80%"></div>
            <div class="template-line" style="width:90%"></div>
          </div>
          <div class="template-name">{name}</div>
        </div>
      ))}
    </div>
  </section>

  <div style="height:1px;background:var(--color-border)"></div>

  <section class="wrap closing-cta">
    <h2 class="closing-cta-title">Build your resume once. Najah tailors it forever.</h2>
    <a href={APP_URL} class="btn-primary closing-cta-btn">Build my resume free</a>
  </section>

  <FooterSimple />
</BaseLayout>
