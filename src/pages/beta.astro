---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import FooterSimple from "../components/FooterSimple.astro";
import { APP_URL, BETA_ZIP_URL } from "../lib/site";
const steps = ["Download and extract the ZIP into a permanent folder such as Documents/Najah AI Beta. Do not load the ZIP itself.", "Open chrome://extensions in Chrome and turn on Developer mode.", "Choose Load unpacked and select the extracted folder containing manifest.json.", "Pin Najah AI — Autopilot BETA from the extensions menu. Keep only one Najah AI extension enabled.", "Create or sign in to your personal Najah AI account. Private invitations need activation; when commercial access is offered, subscribe on the website and check your profile. Installing the ZIP does not enable an account or start a subscription.", "Upload your resume, complete your profile and review your generated documents. Keep the signed-in Najah AI website tab open, then open the extension; it connects automatically."];
const permissions = [
  ["Debugger", "Lets the agent inspect and control the application tab, type answers and attach documents. Chrome shows a debugging banner while it is attached."],
  ["Tabs and navigation", "Finds the signed-in Najah AI tab and follows application tabs opened by job platforms."],
  ["Page access and scripting", "Connects to the public Najah AI server and reads the application page needed for the next action. Extra website access can be requested when required."],
  ["Downloads", "Prepares the resume and letter files used by browser uploads and cleans up the temporary files it created."],
  ["Storage", "Keeps the connection token, settings, task state and recent traces in your Chrome profile."],
  ["Background tasks", "Maintains the running agent and recovers task state when Chrome suspends its background process."]
];
---
<BaseLayout title="Install the beta — Najah AI" description="Install, update and report a problem with the Najah AI Chrome beta." path="/beta">
  <Nav />
  <main>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-kicker">Desktop Chrome · Personal account · Manual ZIP installation</div>
    <h1 class="hero-title">Install Najah AI Beta</h1>
    <p class="hero-body">Access is checked on your account: an invitation for the private beta, or a paid subscription when commercial access is enabled. A checkout marked TEST uses a fictitious card only.</p>
    <p class="hero-body">No Python, Docker or AI API key is needed. This beta is distributed manually, not through the Chrome Web Store.</p>
    <div class="hero-actions">
      <a href={BETA_ZIP_URL} class="btn-primary">Download the beta ZIP</a>
      <a href={APP_URL} class="btn-ghost">Open Najah AI</a>
    </div>
    </div>
  </section>
  <section class="wrap templates-section">
    <div class="mock-list">
    <section class="plan"><h2 class="plan-name">Install and connect</h2><ol class="plan-features">{steps.map((step, index) => <li>{index + 1}. {step}</li>)}</ol>
    <p><a href={APP_URL}>Open Najah AI and sign in</a>. Your profile, subscription and budget are managed in the application. Sharing the ZIP does not grant account access.</p></section>
    <section class="plan"><h2 class="plan-name">Your first application</h2>
    <p>The agent can submit real applications. Review your documents and stay at your computer. Pause or Stop to take over. Complete login, CAPTCHA and personal questions yourself, then Resume. Keep the application tab open and do not dismiss Chrome’s debugging banner.</p></section>
    <section class="plan"><h2 class="plan-name">What permissions mean</h2>
    {permissions.map(([title, body]) => <section class="mock-col"><h3 class="mock-col-title">{title}</h3><p class="plan-desc">{body}</p></section>)}
    <p>Application page information is sent to Najah AI and relevant information is processed by AI providers. Read the <a href="/privacy">Privacy Policy</a> before starting.</p></section>
    <section class="plan"><h2 class="plan-name">Update</h2>
    <p>Stop the agent first. Extract the new ZIP and replace the contents of the same installation folder. At chrome://extensions, click Reload on the Najah AI card, then check its version. ZIP releases do not update automatically. Keep only one version enabled.</p></section>
    <section class="plan"><h2 class="plan-name">Report a problem</h2>
    <p>Email <a href="mailto:bachirdiaw56100@gmail.com">Bachir Diaw — bachirdiaw56100@gmail.com</a> with your operating system, Chrome version, extension version, job platform, approximate time and what happened. If a trace is needed, use Logs in the extension and review it before sharing. Never send passwords, login tokens or API keys.</p></section>
    <section class="plan"><h2 class="plan-name">If access is paused</h2>
    <p>Check your application profile if account access or budget is unavailable. Technical daily limits are separate from your budget and reset at 00:00 UTC. Resume or a recharge does not reset them. A recharge is never purchased automatically.</p></section>
    <section class="plan"><h2 class="plan-name">Remove the extension</h2>
    <p>Stop the agent, then remove Najah AI at chrome://extensions. Removing it does not delete your account, undo applications or cancel a subscription. Manage cancellation and invoices from your application profile.</p></section>
    <p><a href="/terms">Beta terms</a> · <a href="/privacy">Privacy</a></p>
    </div>
  </section>
  </main>
  <FooterSimple />
</BaseLayout>
