---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavMinimal from "../components/NavMinimal.astro";
import FooterSimple from "../components/FooterSimple.astro";
import LegalSection from "../components/LegalSection.astro";

// Placeholder text throughout — legal review still pending, see privacy.astro.
const sections = [
  { title: "1. Acceptance of terms", body: "Placeholder — by using Najah AI or installing the Chrome extension, you agree to these terms." },
  { title: "2. The service", body: "Placeholder — Najah AI discovers jobs, scores them, tailors application documents, and submits applications via an automated browser agent on your behalf." },
  { title: "3. Your responsibilities", body: "Placeholder — you are responsible for the accuracy of your resume and profile information, and for reviewing applications before submission where review is offered." },
  { title: "4. Automated applications", body: "Placeholder — you authorize the Chrome extension to submit job applications on your behalf using your resume, tailored documents, and profile data." },
  { title: "5. Limitations", body: "Placeholder — Najah AI does not guarantee interviews or job offers, and is not responsible for employer application outcomes." },
  { title: "6. Termination", body: "Placeholder — you may stop using the service and delete your account at any time." },
];
---
<BaseLayout
  title="Terms of Service — Najah AI"
  description="The terms governing your use of Najah AI and the auto-apply Chrome extension."
  path="/terms"
>
  <NavMinimal />

  <div style="max-width:820px;margin:0 auto;padding:56px 24px 80px">
    <div style="font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#888;margin-bottom:12px">Legal</div>
    <h1 style="font-weight:800;font-size:32px;letter-spacing:-0.02em;margin:0 0 8px">Terms of Service</h1>
    <p style="font-size:13px;color:#888;margin:0 0 40px">Last updated: [date] · Applies to najahai.com.au and the Najah AI Chrome extension</p>

    {sections.map((sec) => <LegalSection title={sec.title} body={sec.body} />)}

    <div style="display:flex;gap:16px;margin-top:24px">
      <a href="/privacy" style="font-size:13px;font-weight:600">View Privacy Policy</a>
    </div>
  </div>

  <FooterSimple />
</BaseLayout>
