---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import FooterSimple from "../components/FooterSimple.astro";
import { APP_URL } from "../lib/site";

const faqs = [
  { q: "Can I cancel anytime?", a: "Yes — Auto-Apply is billed weekly with no lock-in contract." },
  { q: "Does auto-apply actually submit applications?", a: "Yes — the Chrome extension fills out and submits the real application form on job sites and employer portals." },
];
---
<BaseLayout
  title="Pricing — Najah AI"
  description="One plan. Job discovery, resume tailoring and auto-applying, billed weekly. Cancel anytime."
  path="/pricing"
>
  <Nav active="pricing" />

  <section class="page-hero">
    <div class="page-hero-glow page-hero-glow--pricing"></div>
    <div class="wrap page-hero-inner page-hero-inner--center">
      <h1 class="page-hero-title">Simple pricing, cancel anytime</h1>
      <p class="page-hero-body">One plan. Discovery, tailoring and auto-applying, billed weekly.</p>
    </div>
  </section>

  <section class="wrap plans" style="grid-template-columns:minmax(0,420px);justify-content:center">
    <div class="plan featured">
      <span class="tag-success plan-badge">Most popular</span>
      <div class="plan-name">Auto-Apply</div>
      <div class="plan-desc">The full end-to-end pipeline</div>
      <div class="plan-price plan-price--featured">$50<span class="plan-price-unit">/week</span></div>
      <div class="plan-sub">billed weekly, cancel anytime</div>
      <ul class="plan-features">
        <li>✓ Job discovery &amp; scoring, subject to daily limits</li>
        <li>✓ AUD 30 of AI usage included each week</li>
        <li>✓ Chrome auto-apply extension</li>
        <li>✓ Full application tracker</li>
        <li>✓ Priority job matching</li>
      </ul>
      <a href={`${APP_URL}/static/subscribe.html`} class="btn-primary plan-cta">Subscribe</a>
    </div>

  </section>

  <div style="height:1px;background:var(--color-border)"></div>

  <!-- Les réponses restent dépliées au-dessus de 720px (deux colonnes lisibles
       d'un coup d'œil) ; sous ce seuil elles deviennent un accordéon, comme dans
       le prototype mobile — six écrans de texte d'affilée sinon. -->
  <section class="wrap faq-section">
    <h2 class="faq-title">Questions</h2>
    <div class="faq">
      {faqs.map((item, i) => (
        <div class="faq-item">
          <button type="button" class="faq-q" aria-expanded="false" aria-controls={`faq-a-${i}`}>
            <span>{item.q}</span>
            <span class="faq-sign" aria-hidden="true">+</span>
          </button>
          <p class="faq-a" id={`faq-a-${i}`}>{item.a}</p>
        </div>
      ))}
    </div>
  </section>

  <FooterSimple />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>(".faq-q").forEach((btn) => {
    btn.addEventListener("click", () => {
      const item = btn.closest(".faq-item");
      if (!item) return;
      const open = item.classList.toggle("is-open");
      btn.setAttribute("aria-expanded", open ? "true" : "false");
      const sign = btn.querySelector(".faq-sign");
      if (sign) sign.textContent = open ? "−" : "+";
    });
  });
</script>
