---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import FooterSimple from "../components/FooterSimple.astro";
import { APP_URL } from "../lib/site";
---
<BaseLayout title="Private beta access — Najah AI" description="Invited private beta access and planned paid pricing." path="/pricing">
  <Nav active="pricing" />
  <main style="max-width:820px;margin:0 auto;padding:56px 24px 80px;line-height:1.7">
    <h1>Private beta access</h1>
    <p>The current beta is for invited testers. No payment is required. Accounts have technical daily limits for searches and AI requests; these are not unlimited plans or paid credits.</p>
    <p>Create your account and contact <a href="mailto:bachirdiaw56100@gmail.com">Bachir Diaw</a> to request tester access. Downloading the extension does not grant access.</p>
    <a href={APP_URL} class="btn-primary">Create or sign in to your account</a>
    <h2>Planned paid version</h2>
    <p>The planned subscription is <strong>50 AUD per week</strong>. It is not available for purchase during this beta. Included credits, optional top-ups, cancellation and payment details will be published before paid access opens.</p>
    <p><a href="/beta">Install the beta</a> · <a href="/terms">Beta terms</a></p>
  </main>
  <FooterSimple />
</BaseLayout>
