---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import FooterSimple from "../components/FooterSimple.astro";
import ApplicationsTable from "../components/ApplicationsTable.astro";
---
<BaseLayout
  title="Applications sent — Najah AI"
  description="Every application Najah AI submits is logged automatically — the exact resume and cover letter sent for each job, searchable in seconds."
  path="/applications"
>
  <Nav active="applications" />

  <div class="wrap applications-page">
    <h1 class="applications-title">Applications sent</h1>
    <p class="applications-body">Every application is logged automatically — the exact resume and cover letter sent for each job. When an employer calls, pull up what you sent in seconds.</p>

    <ApplicationsTable />
  </div>

  <FooterSimple />
</BaseLayout>
