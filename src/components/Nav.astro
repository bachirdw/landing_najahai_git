---
import { APP_URL } from "../lib/site";

interface Props {
  active?: "resume-builder" | "applications" | "pricing";
}
const { active } = Astro.props;

const linkClass = (id: string) => (id === active ? "nav-link is-active" : "nav-link");
---
<header class="site-header">
  <div class="wrap nav-bar">
    <a href="/" class="nav-brand">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2"><path d="M6 2h12M6 22h12M6 2c0 5 4 6 6 8-2 2-6 3-6 8M18 2c0 5-4 6-6 8 2 2 6 3 6 8"/></svg>
      Najah AI
    </a>

    <!-- Liens complets : visibles au-dessus de 720px seulement. Sous ce seuil ils
         partent dans le menu déroulant ci-dessous — les trois libellés côte à côte
         débordaient l'écran d'un téléphone et poussaient le bouton hors du viewport. -->
    <nav class="nav-links">
      <a href="/resume-builder" class={linkClass("resume-builder")}>Resume Builder</a>
      <a href="/applications" class={linkClass("applications")}>Application Tracker</a>
      <a href="/pricing" class={linkClass("pricing")}>Pricing</a>
    </nav>
    <a href={APP_URL} class="btn-primary nav-cta">Dashboard</a>

    <!-- Version mobile de la barre : « Log in » reste accessible en un tap, le reste
         passe derrière le bouton menu. -->
    <a href={APP_URL} class="nav-login">Log in</a>
    <button
      type="button"
      class="nav-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="nav-menu" id="nav-menu" hidden>
    <a href="/resume-builder" class={linkClass("resume-builder")}>Resume Builder</a>
    <a href="/applications" class={linkClass("applications")}>Application Tracker</a>
    <a href="/pricing" class={linkClass("pricing")}>Pricing</a>
    <a href={APP_URL} class="btn-primary nav-menu-cta">Get started</a>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const menu = document.querySelector<HTMLDivElement>("#nav-menu");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", open ? "false" : "true");
    toggle.setAttribute("aria-label", open ? "Open menu" : "Close menu");
    if (menu) menu.hidden = open;
  });

  // Repasser en desktop laisse sinon le menu ouvert et l'attribut aria-expanded
  // à true, alors que la barre complète est de nouveau affichée.
  window.matchMedia("(min-width: 721px)").addEventListener("change", (e) => {
    if (!e.matches) return;
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute("aria-label", "Open menu");
    if (menu) menu.hidden = true;
  });
</script>
