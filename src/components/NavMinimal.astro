---
// Reduced nav used on Applications and Legal — matches the Claude Design
// source for those pages exactly: no Pricing link, no separate Dashboard
// link, just the two product links and a single "Get started" CTA.
import { APP_URL } from "../lib/site";

interface Props {
  active?: "resume-builder" | "applications";
}
const { active } = Astro.props;

const linkStyle = (id: string) =>
  id === active ? "font-size:14.5px;color:#111;font-weight:600" : "font-size:14.5px;color:#333";
---
<header style="border-bottom:1px solid var(--color-border)">
  <div class="wrap" style="display:flex;align-items:center;gap:36px;padding:18px 24px">
    <a href="/" style="display:flex;align-items:center;gap:9px;font-weight:800;font-size:16px">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2"><path d="M6 2h12M6 22h12M6 2c0 5 4 6 6 8-2 2-6 3-6 8M18 2c0 5-4 6-6 8 2 2 6 3 6 8"/></svg>
      Najah AI
    </a>
    <nav style="display:flex;gap:28px;margin-right:auto">
      <a href="/resume-builder" style={linkStyle("resume-builder")}>Resume Builder</a>
      <a href="/applications" style={linkStyle("applications")}>Application Tracker</a>
    </nav>
    <a href={APP_URL} class="btn-primary">Dashboard</a>
  </div>
</header>
