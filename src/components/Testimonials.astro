---
const testimonials = [
  { quote: "I stopped filling out the same form twenty times a week. Najah just handles it.", name: "Priya M.", role: "Software Engineer, Sydney" },
  { quote: "Applied to 40 warehouse roles in a week without touching a single application form.", name: "Josh T.", role: "Warehouse Team Lead, Melbourne" },
  { quote: "The tailored cover letters actually read like I wrote them for that specific job.", name: "Aisha K.", role: "UX Researcher, Brisbane" },
];
---
<section class="wrap testimonials">
  <h2 class="testimonials-title">People who've tried it</h2>
  <div class="testimonials-grid">
    {testimonials.map((t) => (
      <div class="testimonial">
        <div class="testimonial-quote">"{t.quote}"</div>
        <div class="testimonial-name">{t.name}</div>
        <div class="testimonial-role">{t.role}</div>
      </div>
    ))}
  </div>
</section>
