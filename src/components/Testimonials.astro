---
const testimonials = [
  { quote: "I stopped filling out the same form twenty times a week. Najah just handles it.", name: "Priya M.", role: "Software Engineer, Sydney" },
  { quote: "Applied to 40 warehouse roles in a week without touching a single application form.", name: "Josh T.", role: "Warehouse Team Lead, Melbourne" },
  { quote: "The tailored cover letters actually read like I wrote them for that specific job.", name: "Aisha K.", role: "UX Researcher, Brisbane" },
];
---
<section class="wrap" style="padding:64px 24px">
  <h2 style="font-weight:800;font-size:26px;text-align:center;margin:0 0 40px;letter-spacing:-0.01em">People who've tried it</h2>
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px">
    {testimonials.map((t) => (
      <div style="border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:22px">
        <div style="font-size:14.5px;line-height:1.6;color:#222;margin-bottom:16px">"{t.quote}"</div>
        <div style="font-weight:700;font-size:13.5px">{t.name}</div>
        <div style="font-size:12.5px;color:#888">{t.role}</div>
      </div>
    ))}
  </div>
</section>
