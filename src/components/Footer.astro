---
import { CHROME_STORE_URL } from "../lib/site";
---
<footer style="background:#111;color:#fff">
  <div class="wrap" style="padding:52px 24px 28px">
    <div style="display:flex;align-items:center;gap:9px;font-weight:800;font-size:16px;margin-bottom:10px">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M6 2h12M6 22h12M6 2c0 5 4 6 6 8-2 2-6 3-6 8M18 2c0 5-4 6-6 8 2 2 6 3 6 8"/></svg>
      Najah AI
    </div>
    <p style="font-size:13.5px;color:#999;margin:0 0 32px">Applying for Australian jobs, automatically.</p>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:24px;border-top:1px solid #2a2a2a;padding-top:26px">
      <div>
        <div style="font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#999;margin-bottom:12px">Product</div>
        <div style="display:flex;flex-direction:column;gap:8px;font-size:13.5px">
          <a href="/resume-builder" style="color:#fff">Resume Builder</a>
          <a href="/applications" style="color:#fff">Application Tracker</a>
          <a href={CHROME_STORE_URL} target="_blank" rel="noopener noreferrer" style="color:#fff">Chrome Extension</a>
          <a href="/pricing" style="color:#fff">Pricing</a>
        </div>
      </div>
      <div>
        <div style="font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#999;margin-bottom:12px">Company</div>
        <div style="display:flex;flex-direction:column;gap:8px;font-size:13.5px">
          <a href="#" style="color:#fff">About</a>
          <a href="#" style="color:#fff">Careers</a>
          <a href="#" style="color:#fff">Contact</a>
        </div>
      </div>
      <div>
        <div style="font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#999;margin-bottom:12px">Legal</div>
        <div style="display:flex;flex-direction:column;gap:8px;font-size:13.5px">
          <a href="/privacy" style="color:#fff">Privacy</a>
          <a href="/terms" style="color:#fff">Terms</a>
        </div>
      </div>
      <div>
        <div style="font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#999;margin-bottom:12px">Follow</div>
        <div style="display:flex;flex-direction:column;gap:8px;font-size:13.5px">
          <a href="#" style="color:#fff">LinkedIn</a>
          <a href="#" style="color:#fff">X</a>
        </div>
      </div>
    </div>
    <div style="border-top:1px solid #2a2a2a;margin-top:26px;padding-top:20px;font-size:12.5px;color:#999">© 2026 Najah AI. All rights reserved.</div>
  </div>
</footer>
