---
import { CHROME_STORE_URL } from "../lib/site";
---
<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M6 2h12M6 22h12M6 2c0 5 4 6 6 8-2 2-6 3-6 8M18 2c0 5-4 6-6 8 2 2 6 3 6 8"/></svg>
      Najah AI
    </div>
    <p class="footer-tagline">Applying for Australian jobs, automatically.</p>
    <!-- Quatre colonnes en desktop, deux en mobile : les libellés sont trop longs
         pour tenir sur quatre colonnes à 375px. -->
    <div class="footer-grid">
      <div>
        <div class="footer-col-title">Product</div>
        <div class="footer-links">
          <a href="/resume-builder">Resume Builder</a>
          <a href="/applications">Application Tracker</a>
          <a href={CHROME_STORE_URL} target="_blank" rel="noopener noreferrer">Chrome Extension</a>
          <a href="/pricing">Pricing</a>
        </div>
      </div>
      <div>
        <div class="footer-col-title">Company</div>
        <div class="footer-links">
          <a href="#">About</a>
          <a href="#">Careers</a>
          <a href="#">Contact</a>
        </div>
      </div>
      <div>
        <div class="footer-col-title">Legal</div>
        <div class="footer-links">
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
        </div>
      </div>
      <div>
        <div class="footer-col-title">Follow</div>
        <div class="footer-links">
          <a href="#">LinkedIn</a>
          <a href="#">X</a>
        </div>
      </div>
    </div>
    <div class="footer-legal">© 2026 Najah AI. All rights reserved.</div>
  </div>
</footer>
