---
const items = [
  { title: "Privacy", body: "How we collect, store and use your resume and application data.", href: "/privacy", cta: "Read the privacy policy →" },
  { title: "Terms of service", body: "The terms governing your use of Najah AI and the auto-apply extension.", href: "/terms", cta: "Read the terms →" },
  { title: "Data handling", body: "You control what's shared with employers, and can delete your data anytime.", href: "/privacy#data", cta: "See data controls →" },
];
---
<section class="wrap legal-teaser">
  <h2 class="legal-teaser-title">Your data, handled properly</h2>
  <div class="legal-teaser-grid">
    {items.map((item) => (
      <div>
        <div class="legal-teaser-item-title">{item.title}</div>
        <p class="legal-teaser-item-body">{item.body}</p>
        <a href={item.href} class="legal-teaser-link">{item.cta}</a>
      </div>
    ))}
  </div>
</section>
