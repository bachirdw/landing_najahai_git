<section class="wrap" style="padding:56px 24px">
  <h2 style="font-weight:800;font-size:20px;margin:0 0 24px;letter-spacing:-0.01em">Your data, handled properly</h2>
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:28px">
    <div>
      <div style="font-weight:700;font-size:14.5px;margin-bottom:8px">Privacy</div>
      <p style="font-size:13.5px;color:#666;line-height:1.6;margin:0 0 8px">How we collect, store and use your resume and application data.</p>
      <a href="/privacy" style="font-size:13px;font-weight:600">Read the privacy policy →</a>
    </div>
    <div>
      <div style="font-weight:700;font-size:14.5px;margin-bottom:8px">Terms of service</div>
      <p style="font-size:13.5px;color:#666;line-height:1.6;margin:0 0 8px">The terms governing your use of Najah AI and the auto-apply extension.</p>
      <a href="/terms" style="font-size:13px;font-weight:600">Read the terms →</a>
    </div>
    <div>
      <div style="font-weight:700;font-size:14.5px;margin-bottom:8px">Data handling</div>
      <p style="font-size:13.5px;color:#666;line-height:1.6;margin:0 0 8px">You control what's shared with employers, and can delete your data anytime.</p>
      <a href="/privacy#data" style="font-size:13px;font-weight:600">See data controls →</a>
