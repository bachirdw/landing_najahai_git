---
import { APP_URL } from "../lib/site";
---
<section style="position:relative;overflow:hidden">
  <div style="position:absolute;inset:0;background:radial-gradient(60% 55% at 30% 10%, rgba(255,196,120,.35), transparent 60%), radial-gradient(55% 50% at 75% 25%, rgba(120,190,255,.3), transparent 60%), radial-gradient(50% 45% at 55% 55%, rgba(255,150,190,.22), transparent 65%);z-index:0"></div>
  <div class="wrap" style="position:relative;z-index:1;padding:88px 24px 64px;text-align:center">
    <div style="font-size:12.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#555;margin-bottom:20px">Auto-apply for Australian jobs</div>
    <h1 style="font-weight:800;font-size:clamp(38px,6vw,68px);line-height:1.06;letter-spacing:-0.02em;margin:0 auto 22px;max-width:17ch">One resume. Every job applied for, automatically.</h1>
    <p style="font-size:17px;line-height:1.6;color:#555;max-width:54ch;margin:0 auto 30px">Najah AI finds matching jobs across SEEK, Indeed, LinkedIn and employer portals, tailors your resume and cover letter for each one, then applies for you.</p>
    <div style="display:flex;gap:12px;justify-content:center">
      <a href={APP_URL} class="btn-primary">Get started free →</a>
      <a href="#pipeline" class="btn-ghost">See how it works</a>
    </div>

    <div class="win" style="margin:56px auto 0;max-width:900px;text-align:left">
      <div class="win-bar"><div class="win-dot"></div><div class="win-dot"></div><div class="win-dot"></div>
        <div class="win-url">app.najahai.com.au/pipeline</div>
      </div>
      <div style="padding:26px;display:grid;grid-template-columns:1.1fr 1fr;gap:20px">
        <div>
          <div style="font-weight:700;font-size:19px;margin-bottom:6px">Senior Product Designer</div>
          <div style="font-size:13px;color:#888;margin-bottom:16px">Sydney, NSW · Canva</div>
          <div style="display:flex;gap:8px">
            <span class="tag-success">8.4 / 10 match</span>
            <span class="tag-outline">Resume tailored</span>
          </div>
        </div>
        <div style="border-left:1px solid var(--color-border);padding-left:20px;display:flex;flex-direction:column;gap:10px;font-size:13px;color:#555">
          <div>✓ Job discovered</div>
          <div>✓ Scored against resume</div>
          <div>✓ Resume tailored</div>
          <div style="color:#111;font-weight:600">→ Applying via Workday…</div>
        </div>
      </div>
    </div>
  </div>
</section>
