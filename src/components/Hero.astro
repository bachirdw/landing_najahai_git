---
import { APP_URL } from "../lib/site";
---
<section class="hero">
  <div class="hero-glow"></div>
  <div class="wrap hero-inner">
    <div class="hero-kicker">Auto-apply for Australian jobs</div>
    <h1 class="hero-title">One resume. Every job applied for, automatically.</h1>
    <p class="hero-body">Najah AI finds matching jobs across SEEK, Indeed, LinkedIn and employer portals, tailors your resume and cover letter for each one, then applies for you.</p>
    <div class="hero-actions">
      <a href={APP_URL} class="btn-primary">Get started free →</a>
      <a href="#pipeline" class="btn-ghost">See how it works</a>
    </div>

    <div class="win hero-win">
      <div class="win-bar"><div class="win-dot"></div><div class="win-dot"></div><div class="win-dot"></div>
        <div class="win-url">app.najahai.com.au/pipeline</div>
      </div>
      <div class="hero-win-body">
        <div>
          <div class="hero-job-title">Senior Product Designer</div>
          <div class="hero-job-meta">Sydney, NSW · Canva</div>
          <div class="hero-job-tags">
            <span class="tag-success">8.4 / 10 match</span>
            <span class="tag-outline">Resume tailored</span>
          </div>
        </div>
        <!-- Étapes du pipeline : colonne de droite en desktop, bloc empilé sous le
             poste en mobile (la séparation passe de border-left à border-top). -->
        <div class="hero-steps">
          <div>✓ Job discovered</div>
          <div>✓ Scored against resume</div>
          <div>✓ Resume tailored</div>
          <div class="hero-step-current">→ Applying via Workday…</div>
        </div>
      </div>
    </div>
  </div>
</section>
