---
interface Props {
  title: string;
  body: string;
}
const { title, body } = Astro.props;
---
<div style="margin-bottom:32px">
  <h2 style="font-weight:700;font-size:18px;margin:0 0 10px;border-bottom:1px solid var(--color-border);padding-bottom:8px">{title}</h2>
  <p style="font-size:14px;line-height:1.7;color:#555;margin:0">{body}</p>
</div>
