---
interface Props {
  kicker: string;
  heading: string;
  body: string;
  ctaText?: string;
  ctaHref?: string;
  ctaExternal?: boolean; // opens in a new tab (e.g. the Chrome Web Store listing)
  visualFirst?: boolean; // true = visual on the left, text on the right
}
const { kicker, heading, body, ctaText, ctaHref, ctaExternal = false, visualFirst = false } = Astro.props;
---
<!-- visualFirst n'inverse les colonnes qu'en desktop : en mobile le texte précède
     toujours son illustration, sinon un bloc sur deux commencerait par une image
     sans contexte. -->
<section class:list={["wrap", "feature", { "feature--visual-first": visualFirst }]}>
  <div class="feature-text">
    <div class="feature-kicker">{kicker}</div>
    <h2 class="feature-heading">{heading}</h2>
    <p class="feature-body">{body}</p>
    {ctaText && ctaHref && (
      ctaExternal
        ? <a href={ctaHref} class="btn-ghost" target="_blank" rel="noopener noreferrer">{ctaText}</a>
        : <a href={ctaHref} class="btn-ghost">{ctaText}</a>
    )}
  </div>
  <div class="feature-visual">
    <slot />
  </div>
</section>
